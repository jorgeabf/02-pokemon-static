---
import Navbar from '@components/shared/Navbar.astro'
import { ClientRouter } from 'astro:transitions'
import { SITE_INFO } from 'consts/site-info'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  // La página mide justo la pantalla bajo el menú, y la página elige qué se
  // encoge para caber (con h-full dentro de main). Solo si no cabe ni así
  // hay scroll
  fitScreen?: boolean
}

const { SITE_TITLE, SITE_DESCRIPTION, SITE_IMAGE, THEME_COLOR } = SITE_INFO

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = SITE_IMAGE,
  fitScreen = false
} = Astro.props
---

<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    <link
      rel='manifest'
      href='/manifest.webmanifest'
    />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1'
    />
    <meta
      name='theme-color'
      content={THEME_COLOR}
    />
    <title>{title}</title>
    <meta
      name='description'
      content={description}
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:url'
      content={Astro.url.href}
    />
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={description}
    />
    <meta
      property='og:image'
      content={image}
    />
    <ClientRouter />
  </head>

  <body
    class:list={[
      'bg-slate-800 text-slate-100 select-none',
      { 'flex flex-col h-dvh': fitScreen }
    ]}
  >
    <Navbar />
    {/* fitScreen: main ocupa el alto que deja el menú en el body de h-dvh, y
        ese alto es fijo, así que un h-full dentro se resuelve. min-h-0 deja a
        main más bajo que su contenido (si no, crecería hasta él y no se
        encogería nada); w-full, porque en flex mx-auto lo encogería */}
    <main
      class:list={[
        'max-w-6xl mx-auto px-6 pb-6 relative',
        { 'flex-1 min-h-0 w-full': fitScreen }
      ]}
    >
      <slot />
    </main>
    <script>
      import { registerServiceWorker } from 'scripts/service-worker'
      import { speak } from 'scripts/sounds'

      // Cualquier elemento con data-speak dice su texto al tocarlo
      document.addEventListener('click', (event) => {
        const target = (event.target as Element).closest<HTMLElement>('[data-speak]')
        if (target?.dataset.speak) speak(target.dataset.speak)
      })

      // Un niño deja el dedo quieto encima de las cosas: que no se abra el menú
      // de Chrome (descargar la imagen, abrir en otra pestaña…) ni empiece a
      // arrastrar la imagen. El texto no se selecciona por select-none en el
      // body, pero el menú en Android no se puede evitar solo con CSS
      // (-webkit-touch-callout es de iOS)
      document.addEventListener('contextmenu', (event) => event.preventDefault())
      document.addEventListener('dragstart', (event) => event.preventDefault())

      // Cuando ya ha cargado la página: lo que guarda para jugar sin conexión
      // no le quita conexión a lo primero que se ve. Si la app estaba abierta
      // desde antes de un despliegue, este script llega al navegar (lo ejecuta
      // el ClientRouter) y load ya pasó: entonces, ya
      if (document.readyState === 'complete') {
        registerServiceWorker()
      } else {
        window.addEventListener('load', registerServiceWorker, { once: true })
      }
    </script>
  </body>
</html>
