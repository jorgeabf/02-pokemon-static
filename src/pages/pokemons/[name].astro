---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import MainLayout from '@layouts/MainLayout.astro'
import { Icon } from 'astro-icon/components'
import EvolutionChain from '@components/pokemons/EvolutionChain.astro'
import PageHeader from '@components/shared/PageHeader.astro'
import PageTitle from '@components/shared/PageTitle.astro'
import {
  getDescriptions,
  getEvolutions,
  getSpanishNames,
  toSpokenName
} from 'services/pokemon-species'

export const getStaticPaths = (async () => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151')

  const { results } = (await resp.json()) as PokemonListResponse

  return results.map(({ name, url }) => ({
    params: {
      name: name
    },
    props: {
      url: url,
      name: name
    }
  }))
}) satisfies GetStaticPaths

const { name } = Astro.params
const { url } = Astro.props

const id = url.split('/').at(-2)

const spanishName = (await getSpanishNames())[name] ?? name
const description = (await getDescriptions())[name]
const evolution = (await getEvolutions())[name]

const PAGE_TITLE = `#${id} ${spanishName.toLocaleUpperCase()}`

const spokenName = toSpokenName(spanishName)

const SPRITES_URL =
  'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon'
const audioSrc = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`
const imageSrc = `${SPRITES_URL}/other/official-artwork/${id}.png`
const shinyImageSrc = `${SPRITES_URL}/other/official-artwork/shiny/${id}.png`
const animatedSrc = `${SPRITES_URL}/versions/generation-v/black-white/animated/${id}.gif`
const shinyAnimatedSrc = `${SPRITES_URL}/versions/generation-v/black-white/animated/shiny/${id}.gif`
---

<MainLayout
  title={PAGE_TITLE}
  description={`Información, Imagen y Sonido del Pokémon ${spanishName.toLocaleUpperCase()}`}
  image={imageSrc}
>
  <PageHeader>
    <button
      onclick='history.back()'
      aria-label='Volver'
      class='btn'
    >
      <Icon
        name='arrow-left'
        size={40}
      />
    </button>
    <PageTitle>
      {PAGE_TITLE}
    </PageTitle>
    <button
      id='btn-favorite'
      aria-label='Favorito'
      aria-pressed='false'
      class='hover:animate-pulse'
      data-name={name}
      data-id={id}
    >
      <Icon
        name='heart-outline'
        data-outline
        size={40}
      />
      <Icon
        name='heart-full'
        data-full
        size={40}
        color='red'
        class='hidden'
      />
    </button>
  </PageHeader>

  {/* La casilla «Brillante» cambia las imágenes solo con CSS (group-has-checked) */}
  <div class='group'>
    <div
      id='pokemon-image'
      class='p-8 rounded-2xl bg-slate-900 border border-slate-600 cursor-pointer transition-transform active:scale-95'
    >
      <Image
        transition:name={`${name}-image`}
        src={imageSrc}
        alt={`Imagen de ${spanishName}`}
        class='mx-auto group-has-checked:hidden'
        width={360}
        height={360}
        format='avif'
        loading='eager'
      />
      <img
        src={shinyImageSrc}
        alt={`Imagen de ${spanishName} brillante`}
        class='hidden mx-auto group-has-checked:block'
        width='360'
        height='360'
        loading='lazy'
      />
    </div>

    <div class='grid grid-cols-3 gap-4 max-w-sm mx-auto mt-6'>
      <button
        id='btn-cry'
        aria-label='Sonido'
        class='btn-big bg-orange-700 hover:bg-orange-800'
      >
        <Icon
          name='speaker'
          size={40}
        />
      </button>
      <button
        aria-label='Nombre'
        class='btn-big bg-indigo-600 hover:bg-indigo-700'
        data-speak={spokenName}
      >
        <Icon
          name='voice'
          size={40}
        />
      </button>
      <label
        class='btn-big cursor-pointer bg-slate-600 has-checked:bg-yellow-400 has-checked:text-slate-900 has-focus-visible:outline-2 has-focus-visible:outline-white'
      >
        <input
          type='checkbox'
          aria-label='Brillante'
          class='sr-only'
        />
        <Icon
          name='sparkle'
          size={40}
        />
      </label>
    </div>

    {
      description && (
        <button
          class='flex items-center gap-4 w-full max-w-sm mx-auto mt-6 p-4 rounded-2xl bg-slate-900 border border-slate-600 text-left transition-transform active:scale-95'
          data-speak={description}
        >
          <img
            src={animatedSrc}
            alt=''
            class='size-24 shrink-0 object-contain [image-rendering:pixelated] group-has-checked:hidden'
          />
          <img
            src={shinyAnimatedSrc}
            alt=''
            loading='lazy'
            class='hidden size-24 shrink-0 object-contain [image-rendering:pixelated] group-has-checked:block'
          />
          <span>{description}</span>
        </button>
      )
    }
  </div>

  {
    evolution && evolution.evolvesTo.length > 0 && (
      <EvolutionChain
        evolution={evolution}
        current={name}
      />
    )
  }
  <audio
    id='cry'
    preload='auto'
  >
    <source
      src={audioSrc}
      type='audio/ogg'
    />
  </audio>

  <script>
    import type { FavoritePokemon } from 'interfaces/favorite-pokemon'
    import { playSound } from 'scripts/sounds'

    const handlePageLoad = () => {
      let favorites: FavoritePokemon[] = JSON.parse(
        localStorage.getItem('favorites') ?? '[]'
      )

      const btnFavorite = document.getElementById(
        'btn-favorite'
      ) as HTMLButtonElement

      if (!btnFavorite) return

      const name = btnFavorite.dataset.name ?? ''
      const id = btnFavorite.dataset.id ?? ''

      const heartOutline = btnFavorite.querySelector(
        '[data-outline]'
      ) as HTMLElement
      const heartFull = btnFavorite.querySelector('[data-full]') as HTMLElement

      const isFavorite = () => favorites.some((fav) => fav.name === name)

      const showFavorite = () => {
        heartOutline.classList.toggle('hidden', isFavorite())
        heartFull.classList.toggle('hidden', !isFavorite())
        btnFavorite.setAttribute('aria-pressed', String(isFavorite()))
      }

      const toggleFavorite = () => {
        if (isFavorite()) {
          favorites = favorites.filter((fav) => fav.name !== name)
        } else {
          favorites.push({ id: +id, name })
        }

        localStorage.setItem('favorites', JSON.stringify(favorites))
        showFavorite()
      }

      showFavorite()
      btnFavorite.addEventListener('click', toggleFavorite)
    }

    document.addEventListener('astro:page-load', handlePageLoad)

    const handleSounds = () => {
      const cry = document.getElementById('cry') as HTMLAudioElement
      const pokemonImage = document.getElementById('pokemon-image') as HTMLDivElement
      const btnCry = document.getElementById('btn-cry') as HTMLButtonElement

      if (!cry || !pokemonImage || !btnCry) return

      pokemonImage.addEventListener('click', () => playSound(cry))
      btnCry.addEventListener('click', () => playSound(cry))
    }

    document.addEventListener('astro:page-load', handleSounds)
  </script>
</MainLayout>
