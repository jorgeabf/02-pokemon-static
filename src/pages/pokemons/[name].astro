---
import type { GetStaticPaths } from 'astro'
import MainLayout from '@layouts/MainLayout.astro'
import { Icon } from 'astro-icon/components'
import EvolutionChain from '@components/pokemons/EvolutionChain.astro'
import PageHeader from '@components/shared/PageHeader.astro'
import PageTitle from '@components/shared/PageTitle.astro'
import { IBAI_HEIGHT } from 'consts/ibai'
import { sayHeight } from 'scripts/heights'
import {
  getAnimatedUrl,
  getCryUrl,
  getPokemonImage,
  getRemoteImageUrl,
  getShinyAnimatedUrl,
  getShinyImageUrl
} from 'services/pokemon-images'
import {
  getDescriptions,
  getEvolutions,
  getHeights,
  getSpanishNames,
  toSpokenName
} from 'services/pokemon-species'

// La figura de Ibai (src/icons/child.svg, el niño de pie de Noto con el
// viewBox ajustado a la figura) mide 42,85 × 120,23; la imagen del Pokémon
// es cuadrada
const CHILD_ASPECT = 42.85 / 120.23

// Lo que dice la voz al compararse
const compareWithIbai = (meters: number) => {
  const times = meters / IBAI_HEIGHT
  if (times >= 3) return '¡mucho más grande que tú!'
  if (times > 1.2) return '¡más grande que tú!'
  if (times >= 0.8) return '¡casi como tú!'
  if (times >= 1 / 3) return '¡tú eres más grande!'
  return '¡tú eres mucho más grande!'
}

export const getStaticPaths = (async () => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151')

  const { results } = (await resp.json()) as PokemonListResponse

  // previous y next: los de al lado por número, para las flechas de la imagen
  return results.map(({ name, url }, index) => ({
    params: {
      name: name
    },
    props: {
      url: url,
      name: name,
      previous: results[index - 1]?.name,
      next: results[index + 1]?.name
    }
  }))
}) satisfies GetStaticPaths

const { name } = Astro.params
const { url, previous, next } = Astro.props

const id = url.split('/').at(-2) ?? ''

const spanishName = (await getSpanishNames())[name] ?? name
const description = (await getDescriptions())[name]
const evolution = (await getEvolutions())[name]

const PAGE_TITLE = `#${id} ${spanishName.toLocaleUpperCase()}`

const spokenName = toSpokenName(spanishName)

// ¿Más grande que yo?: lo que mide (en metros) y la escena (.size-compare)
const height = (await getHeights())[name]
const sizePhrase = `${spokenName} mide ${sayHeight(height)}: ${compareWithIbai(height)}`
const sizeScene = `--tallest: ${Math.max(height, IBAI_HEIGHT)}; --width: ${CHILD_ASPECT * IBAI_HEIGHT + height}`

const audioSrc = getCryUrl(id)
const imageSrc = await getPokemonImage(id)
const shinyImageSrc = getShinyImageUrl(id)
const animatedSrc = getAnimatedUrl(id)
const shinyAnimatedSrc = getShinyAnimatedUrl(id)
---

<MainLayout
  title={PAGE_TITLE}
  description={`Información, Imagen y Sonido del Pokémon ${spanishName.toLocaleUpperCase()}`}
  image={getRemoteImageUrl(id)}
  fitScreen
>
  {/* Una columna del alto de la pantalla: si no cabe todo, se encoge la
      imagen (hasta min-h-40) y lo demás se queda como está. group: las
      casillas «Brillante» (#shiny) y «¿Más grande que yo?» (#compare)
      cambian lo que se ve solo con CSS (group-has-[#…:checked]) */}
  <div class='group flex flex-col h-full'>
    <PageHeader>
      <button
        onclick='history.back()'
        aria-label='Volver'
        class='btn'
      >
        <Icon
          name='arrow-left'
          size={40}
        />
      </button>
      <PageTitle>
        {PAGE_TITLE}
      </PageTitle>
      <button
        id='btn-favorite'
        aria-label='Favorito'
        aria-pressed='false'
        class='hover:animate-pulse'
        data-name={name}
        data-id={id}
      >
        <Icon
          name='heart-outline'
          data-outline
          size={40}
        />
        <Icon
          name='heart-full'
          data-full
          size={40}
          color='red'
          class='hidden'
        />
      </button>
    </PageHeader>

    {/* La tarjeta de la imagen y, encima de sus lados, las flechas al
        anterior y al siguiente. Fuera de la tarjeta: tocarlas no hace sonar
        el grito ni la encoge (active:scale-95). Lo que se encoge para caber
        es este envoltorio; la tarjeta lo llena (h-full) */}
    <div class='relative min-h-40'>
      {/* max-h-full: la imagen sigue a la tarjeta cuando se encoge, y
          object-contain la dibuja entera, sin estirarla, en lo que queda */}
      <div
        id='pokemon-image'
        class='relative h-full px-8 py-4 rounded-2xl bg-slate-900 border border-slate-600 cursor-pointer transition-transform active:scale-95'
      >
        <img
          transition:name={`${name}-image`}
          src={imageSrc}
          alt={`Imagen de ${spanishName}`}
          class='max-h-full mx-auto object-contain group-has-[#shiny:checked]:hidden group-has-[#compare:checked]:invisible'
          width='360'
          height='360'
          loading='eager'
          decoding='async'
        />
        <img
          src={shinyImageSrc}
          alt={`Imagen de ${spanishName} brillante`}
          class='hidden max-h-full mx-auto object-contain group-has-[#shiny:checked]:block group-has-[#compare:checked]:invisible'
          width='360'
          height='360'
          loading='lazy'
        />
        {/* ¿Más grande que yo?: Ibai y el Pokémon de pie, a escala
            (.size-compare), en el sitio de la imagen. La imagen sigue ahí,
            invisible, para que la tarjeta no cambie de tamaño */}
        <div
          class='size-compare absolute inset-x-8 inset-y-4 hidden items-end justify-center border-b-4 border-green-600 group-has-[#compare:checked]:flex'
          style={sizeScene}
        >
          <Icon
            name='child'
            class='w-auto'
            style={`--meters: ${IBAI_HEIGHT}`}
          />
          <img
            src={imageSrc}
            alt=''
            class='aspect-square w-auto group-has-[#shiny:checked]:hidden'
            style={`--meters: ${height}`}
          />
          <img
            src={shinyImageSrc}
            alt=''
            loading='lazy'
            class='hidden aspect-square w-auto group-has-[#shiny:checked]:block'
            style={`--meters: ${height}`}
          />
        </div>
      </div>

      {/* replace: pasar de uno a otro no llena el historial, y «Volver» sigue
          llevando a donde se estaba antes (la lista, el álbum…). En el #1 no
          hay anterior ni en el #151 siguiente */}
      {
        previous && (
          <a
            href={`/pokemons/${previous}`}
            data-astro-history='replace'
            aria-label='Anterior'
            class='btn absolute left-1 top-1/2 -translate-y-1/2'
          >
            <Icon
              name='arrow-left'
              size={40}
            />
          </a>
        )
      }
      {
        next && (
          <a
            href={`/pokemons/${next}`}
            data-astro-history='replace'
            aria-label='Siguiente'
            class='btn absolute right-1 top-1/2 -translate-y-1/2'
          >
            <Icon
              name='arrow-right'
              size={40}
            />
          </a>
        )
      }
    </div>

    {/* w-full: en flex, mx-auto lo encogería al ancho de los iconos */}
    <div class='grid grid-cols-4 gap-4 w-full max-w-sm mx-auto mt-4'>
      <button
        id='btn-cry'
        aria-label='Sonido'
        class='btn-big bg-orange-700 hover:bg-orange-800'
      >
        <Icon
          name='speaker'
          size={40}
        />
      </button>
      <button
        aria-label='Nombre'
        class='btn-big bg-indigo-600 hover:bg-indigo-700'
        data-speak={spokenName}
      >
        <Icon
          name='voice'
          size={40}
        />
      </button>
      <label
        class='btn-big cursor-pointer bg-slate-600 has-checked:bg-yellow-400 has-checked:text-slate-900 has-focus-visible:outline-2 has-focus-visible:outline-white'
      >
        <input
          id='shiny'
          type='checkbox'
          aria-label='Brillante'
          class='sr-only'
        />
        <Icon
          name='sparkle'
          size={40}
        />
      </label>
      {/* Al encenderla, la voz dice lo que mide (el script lee data-phrase) */}
      <label
        class='btn-big cursor-pointer bg-slate-600 has-checked:bg-sky-400 has-checked:text-slate-900 has-focus-visible:outline-2 has-focus-visible:outline-white'
      >
        <input
          id='compare'
          type='checkbox'
          aria-label='¿Más grande que yo?'
          class='sr-only'
          data-phrase={sizePhrase}
        />
        <Icon
          name='child'
          size={40}
        />
      </label>
    </div>

    {
      description && (
        <button
          class='flex items-center gap-4 w-full max-w-sm mx-auto mt-4 p-4 rounded-2xl bg-slate-900 border border-slate-600 text-left transition-transform active:scale-95'
          data-speak={description}
        >
          <img
            src={animatedSrc}
            alt=''
            class='size-24 shrink-0 object-contain [image-rendering:pixelated] group-has-[#shiny:checked]:hidden'
          />
          <img
            src={shinyAnimatedSrc}
            alt=''
            loading='lazy'
            class='hidden size-24 shrink-0 object-contain [image-rendering:pixelated] group-has-[#shiny:checked]:block'
          />
          <span>{description}</span>
        </button>
      )
    }

    {
      evolution && evolution.evolvesTo.length > 0 && (
        <EvolutionChain
          evolution={evolution}
          current={name}
        />
      )
    }
  </div>
  <audio
    id='cry'
    preload='auto'
  >
    <source
      src={audioSrc}
      type='audio/ogg'
    />
  </audio>

  <script>
    import type { FavoritePokemon } from 'interfaces/favorite-pokemon'
    import { playSound, speak } from 'scripts/sounds'

    const handlePageLoad = () => {
      let favorites: FavoritePokemon[] = JSON.parse(
        localStorage.getItem('favorites') ?? '[]'
      )

      const btnFavorite = document.getElementById(
        'btn-favorite'
      ) as HTMLButtonElement

      if (!btnFavorite) return

      const name = btnFavorite.dataset.name ?? ''
      const id = btnFavorite.dataset.id ?? ''

      const heartOutline = btnFavorite.querySelector(
        '[data-outline]'
      ) as HTMLElement
      const heartFull = btnFavorite.querySelector('[data-full]') as HTMLElement

      const isFavorite = () => favorites.some((fav) => fav.name === name)

      const showFavorite = () => {
        heartOutline.classList.toggle('hidden', isFavorite())
        heartFull.classList.toggle('hidden', !isFavorite())
        btnFavorite.setAttribute('aria-pressed', String(isFavorite()))
      }

      const toggleFavorite = () => {
        if (isFavorite()) {
          favorites = favorites.filter((fav) => fav.name !== name)
        } else {
          favorites.push({ id: +id, name })
        }

        localStorage.setItem('favorites', JSON.stringify(favorites))
        showFavorite()
      }

      showFavorite()
      btnFavorite.addEventListener('click', toggleFavorite)
    }

    document.addEventListener('astro:page-load', handlePageLoad)

    const handleSounds = () => {
      const cry = document.getElementById('cry') as HTMLAudioElement
      const pokemonImage = document.getElementById('pokemon-image') as HTMLDivElement
      const btnCry = document.getElementById('btn-cry') as HTMLButtonElement

      if (!cry || !pokemonImage || !btnCry) return

      pokemonImage.addEventListener('click', () => playSound(cry))
      btnCry.addEventListener('click', () => playSound(cry))
    }

    document.addEventListener('astro:page-load', handleSounds)

    // ¿Más grande que yo?: al encenderla dice lo que mide; al apagarla, nada
    const handleCompare = () => {
      const compare = document.getElementById('compare') as HTMLInputElement

      if (!compare) return

      compare.addEventListener('change', () => {
        if (compare.checked) speak(compare.dataset.phrase ?? '')
      })
    }

    document.addEventListener('astro:page-load', handleCompare)
  </script>
</MainLayout>
