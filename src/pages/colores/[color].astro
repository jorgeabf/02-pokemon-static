---
import type { GetStaticPaths } from 'astro'
import { Icon } from 'astro-icon/components'
import PokemonCard from '@components/pokemons/PokemonCard.astro'
import PageHeader from '@components/shared/PageHeader.astro'
import PageTitle from '@components/shared/PageTitle.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { POKEMON_COLORS } from 'consts/pokemon-colors'
import { getColors } from 'services/pokemon-species'

export const getStaticPaths = (async () => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151')
  const { results } = (await resp.json()) as PokemonListResponse
  const colors = await getColors()

  return POKEMON_COLORS.map((color) => ({
    params: { color: color.slug },
    props: {
      color,
      pokemons: results.filter(({ name }) => colors[name] === color.key)
    }
  }))
}) satisfies GetStaticPaths

const { color, pokemons } = Astro.props
---

<MainLayout title={color.name}>
  <PageHeader>
    <a
      href='/colores/'
      aria-label='Volver a los colores'
      class='btn'
    >
      <Icon
        name='arrow-left'
        size={40}
      />
    </a>
    <PageTitle>
      <span
        class:list={[
          'inline-block size-6 mr-2 align-middle rounded-full border-2 border-slate-600',
          color.swatch
        ]}
      />
      {color.name}
    </PageTitle>
    <button
      aria-label={`Decir ${color.name}`}
      class='btn'
      data-speak={color.name}
    >
      <Icon
        name='speaker'
        size={28}
      />
    </button>
  </PageHeader>

  <ul
    aria-label={`Pokémon de color ${color.name.toLowerCase()}`}
    class='grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4'
  >
    {
      pokemons.map(({ name, url }) => (
        <li>
          <PokemonCard
            name={name}
            url={url}
          />
        </li>
      ))
    }
  </ul>
</MainLayout>
