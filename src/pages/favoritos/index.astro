---
import FavoritePokemons from '@components/pokemons/FavoritePokemons'
import PageHeader from '@components/shared/PageHeader.astro'
import PageTitle from '@components/shared/PageTitle.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getPokemonImages } from 'services/pokemon-images'
import {
  getSpanishNames,
  POKEMON_IDS,
  toSpokenName
} from 'services/pokemon-species'

// Como en el menú
const PAGE_TITLE = 'Favoritos'
const spanishNames = await getSpanishNames()
const spokenNames = Object.fromEntries(
  Object.entries(spanishNames).map(([name, spanishName]) => [
    name,
    toSpokenName(spanishName)
  ])
)
// Las de los 151: los favoritos solo se saben en el navegador
const images = await getPokemonImages(POKEMON_IDS)
---

<MainLayout title={PAGE_TITLE}>
  <PageHeader>
    <PageTitle>{PAGE_TITLE}</PageTitle>
  </PageHeader>
  <FavoritePokemons
    client:only='solid-js'
    spanishNames={spanishNames}
    spokenNames={spokenNames}
    images={images}
  />
</MainLayout>
