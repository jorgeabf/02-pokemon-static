---
import { Icon } from 'astro-icon/components'
import PageHeader from '@components/shared/PageHeader.astro'
import PageTitle from '@components/shared/PageTitle.astro'
import Pokeball from '@components/shared/Pokeball.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getWildPokemons } from 'services/game-pokemons'

const PAGE_TITLE = '¡Atrápalo!'

const pokemons = await getWildPokemons()
---

<MainLayout title={PAGE_TITLE}>
  <PageHeader>
    <a
      href='/juegos/'
      aria-label='Volver a los juegos'
      class='btn'
    >
      <Icon
        name='arrow-left'
        size={40}
      />
    </a>
    <PageTitle>{PAGE_TITLE}</PageTitle>
    <button
      aria-label={`Decir ${PAGE_TITLE}`}
      class='btn'
      data-speak={PAGE_TITLE}
    >
      <Icon
        name='speaker'
        size={28}
      />
    </button>
  </PageHeader>

  {/* data-state: idle (esperando), throwing, shaking, caught o escaped. Cada
      paso lo anima el CSS; debajo de cada animación ya está como acaba */}
  <div
    id='wild'
    class='group grid gap-6 max-w-sm mx-auto'
    data-state='idle'
    data-pokemons={JSON.stringify(pokemons)}
  >
    <button
      id='wild-throw'
      aria-label='Lanzar la Pokébola'
      class='grid place-items-center aspect-square p-8 overflow-hidden rounded-2xl bg-linear-to-b transition-transform active:scale-95'
    >
      <img
        id='wild-image'
        alt=''
        class='col-start-1 row-start-1 aspect-square w-3/5 motion-safe:group-data-[state=idle]:animate-pokemon-idle group-data-[state=throwing]:opacity-0 motion-safe:group-data-[state=throwing]:animate-pokemon-absorb group-data-[state=shaking]:opacity-0 group-data-[state=caught]:opacity-0 motion-safe:group-data-[state=escaped]:animate-pokemon-pop'
      />
      {/* Fuera: espera abajo, sin tocar al Pokémon (3/5 del alto), y sube al
          lanzarla. Dentro: se mece sobre su base */}
      <span
        class='col-start-1 row-start-1 w-1/4 group-data-[state=idle]:translate-y-[175%] motion-safe:group-data-[state=throwing]:animate-ball-throw'
      >
        <span
          class='block origin-bottom motion-safe:group-data-[state=shaking]:animate-ball-shake'
        >
          <Pokeball
            class='w-full'
            topClass='group-data-[state=escaped]:opacity-0 motion-safe:group-data-[state=escaped]:animate-ball-open-top'
            bottomClass='group-data-[state=escaped]:opacity-0 motion-safe:group-data-[state=escaped]:animate-ball-open-bottom'
          />
        </span>
      </span>
      <span
        class='col-start-1 row-start-1 size-1/2 rounded-full bg-white opacity-0 motion-safe:group-data-[state=escaped]:animate-ball-flash'
      ></span>
      {/* Destellos al atraparlo */}
      <span
        class='col-start-1 row-start-1 flex justify-between w-1/2 -translate-y-1/2 opacity-0 group-data-[state=caught]:opacity-100 motion-safe:group-data-[state=caught]:animate-pokemon-pop'
      >
        <Icon
          name='sparkle'
          class='size-10 text-yellow-300'
        />
        <Icon
          name='sparkle'
          class='size-10 text-yellow-300'
        />
      </span>
    </button>

    <p
      id='wild-name'
      class='text-center text-3xl font-black'
    >
    </p>

    <button
      id='wild-next'
      aria-label='Otro'
      class='btn-big bg-orange-700 hover:bg-orange-800'
    >
      <Icon
        name='arrow-right'
        size={40}
      />
    </button>
  </div>
  <audio
    id='wild-cry'
    preload='auto'
  ></audio>

  <script>
    import type { WildPokemon } from 'interfaces/game-pokemon'
    import { addToAlbum, getAlbum } from 'scripts/album'
    import { pickOther } from 'scripts/random'
    import { playSound, speak } from 'scripts/sounds'

    type State = 'idle' | 'throwing' | 'shaking' | 'caught' | 'escaped'

    // Más fácil que en los juegos: del 50 % (legendarios, capture_rate 3)
    // al 100 % (Pidgey, 255)
    const catchChance = ({ captureRate }: WildPokemon) =>
      0.5 + (0.5 * captureRate) / 255

    const handleWild = () => {
      const wild = document.getElementById('wild') as HTMLDivElement

      if (!wild) return

      const scene = document.getElementById('wild-throw') as HTMLButtonElement
      const image = document.getElementById('wild-image') as HTMLImageElement
      const name = document.getElementById('wild-name') as HTMLParagraphElement
      const cry = document.getElementById('wild-cry') as HTMLAudioElement
      const btnNext = document.getElementById('wild-next') as HTMLButtonElement

      const pokemons: WildPokemon[] = JSON.parse(wild.dataset.pokemons ?? '[]')
      let current: WildPokemon | undefined
      // Cada Pokémon nuevo es otra ronda: lo que quedara de la anterior se descarta
      let round = 0

      const getState = () => wild.dataset.state as State
      const setState = (state: State) => {
        wild.dataset.state = state
      }

      // Acaban también si se cancelan (al pulsar «Otro»), y sin animaciones
      // (movimiento reducido) no hay nada que esperar
      const animationsEnd = () =>
        Promise.allSettled(
          wild.getAnimations({ subtree: true }).map(({ finished }) => finished)
        )

      const sayAfterCry = (text: string) => {
        cry.onended = () => speak(text)
        playSound(cry)
      }

      // Mejor uno que aún no esté en el álbum; si ya están todos, cualquiera
      const showPokemon = ({ announce }: { announce: boolean }) => {
        round++
        cry.onended = null
        speechSynthesis.cancel()

        const album = getAlbum()
        const missing = pokemons.filter(({ id }) => !album.includes(id))
        const previous = current
        current = pickOther(missing.length > 0 ? missing : pokemons, previous)

        // El fondo es el degradado de su hábitat
        if (previous) scene.classList.remove(...previous.tile.split(' '))
        scene.classList.add(...current.tile.split(' '))
        image.src = current.image
        image.alt = `Imagen de ${current.name}`
        name.textContent = current.name
        cry.src = current.cry
        setState('idle')

        // Al cargar la página aún no se ha tocado nada y el móvil no deja hablar
        if (announce) speak(`¡Un ${current.spokenName} salvaje!`)
      }

      const throwBall = async () => {
        if (!current || getState() !== 'idle') return

        const pokemon = current
        const thisRound = round

        setState('throwing')
        await animationsEnd()
        if (thisRound !== round) return

        setState('shaking')
        await animationsEnd()
        if (thisRound !== round) return

        if (Math.random() < catchChance(pokemon)) {
          const isNew = addToAlbum(pokemon.id)
          setState('caught')
          sayAfterCry(
            `¡Has atrapado a ${pokemon.spokenName}!${isNew ? ' ¡Nuevo en tu álbum!' : ''}`
          )
          return
        }

        setState('escaped')
        speak('¡Oh! ¡Se ha escapado!')
        await animationsEnd()
        if (thisRound !== round) return

        setState('idle')
      }

      scene.addEventListener('click', throwBall)
      btnNext.addEventListener('click', () => showPokemon({ announce: true }))
      showPokemon({ announce: false })
    }

    document.addEventListener('astro:page-load', handleWild)
  </script>
</MainLayout>
