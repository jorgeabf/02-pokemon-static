---
import { Icon } from 'astro-icon/components'
import AlbumPrize from '@components/games/AlbumPrize.astro'
import GameHeader from '@components/games/GameHeader.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getGamePokemons } from 'services/game-pokemons'

const PAGE_TITLE = '¿Dónde está…?'

const pokemons = await getGamePokemons()
---

<MainLayout title={PAGE_TITLE}>
  <GameHeader title={PAGE_TITLE} />

  {/* data-state: asking (preguntando) o found (encontrado). La casilla buena
      lleva data-target y la que se toca sin serlo, data-wrong mientras niega.
      Si lo encuentra a la primera, va al álbum (AlbumPrize) */}
  <div
    id='find'
    class='group relative grid gap-6 max-w-sm mx-auto'
    data-state='asking'
    data-pokemons={JSON.stringify(pokemons)}
  >
    {/* Tres casillas en triángulo: la primera centrada arriba */}
    <div class='grid grid-cols-4 gap-4'>
      {
        [0, 1, 2].map((index) => (
          <button
            data-option
            class:list={[
              'col-span-2 grid place-items-center aspect-square p-3 rounded-2xl bg-radial from-white to-sky-300 transition-[opacity,scale] active:scale-95 motion-safe:data-wrong:animate-pokemon-no group-data-[state=found]:not-data-target:opacity-30 motion-safe:group-data-[state=found]:data-target:animate-battle-cheer',
              index === 0 && 'col-start-2'
            ]}
          >
            <img
              alt=''
              class='aspect-square w-full'
            />
          </button>
        ))
      }
    </div>

    <div class='grid grid-cols-2 gap-4'>
      <button
        id='find-ask'
        aria-label='Repetir la pregunta'
        class='btn-big bg-sky-600 hover:bg-sky-700'
      >
        <Icon
          name='voice'
          size={40}
        />
      </button>
      <button
        id='find-next'
        aria-label='Otro'
        class='btn-big bg-orange-700 hover:bg-orange-800'
      >
        <Icon
          name='arrow-right'
          size={40}
        />
      </button>
    </div>

    {/* La medalla, en la esquina que deja libre el triángulo */}
    <AlbumPrize medalClass='top-0 right-0' />
  </div>
  <audio
    id='find-cry'
    preload='auto'
  ></audio>

  <script>
    import 'scripts/find-game'
  </script>
</MainLayout>
