---
import { Icon } from 'astro-icon/components'
import GameHeader from '@components/games/GameHeader.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getGamePokemons } from 'services/game-pokemons'

const PAGE_TITLE = '¿Quién es ese Pokémon?'

const pokemons = await getGamePokemons()
---

<MainLayout title={PAGE_TITLE}>
  <GameHeader title={PAGE_TITLE} />

  <div
    id='game'
    class='group grid gap-6 max-w-sm mx-auto'
    data-pokemons={JSON.stringify(pokemons)}
  >
    <button
      id='game-reveal'
      aria-label='Descubrir'
      class='p-8 rounded-2xl bg-radial from-yellow-200 to-sky-500 transition-transform active:scale-95'
    >
      <img
        id='game-image'
        alt=''
        class='aspect-square w-full brightness-0 group-data-revealed:brightness-100 group-data-revealed:transition-[filter] group-data-revealed:duration-700'
      />
    </button>

    <p class='text-center text-3xl font-black'>
      <span class='group-data-revealed:hidden'>?</span>
      <span
        id='game-name'
        class='hidden group-data-revealed:inline'
      ></span>
    </p>

    <button
      id='game-next'
      aria-label='Otro'
      class='btn-big bg-orange-700 hover:bg-orange-800'
    >
      <Icon
        name='arrow-right'
        size={40}
      />
    </button>
  </div>
  <audio
    id='game-cry'
    preload='auto'
  ></audio>

  <script>
    import type { GamePokemon } from 'interfaces/game-pokemon'
    import { pickOther } from 'scripts/random'
    import { playSound, speak } from 'scripts/sounds'

    const handleGame = () => {
      const game = document.getElementById('game') as HTMLDivElement

      if (!game) return

      const image = document.getElementById('game-image') as HTMLImageElement
      const name = document.getElementById('game-name') as HTMLSpanElement
      const cry = document.getElementById('game-cry') as HTMLAudioElement
      const btnReveal = document.getElementById('game-reveal') as HTMLButtonElement
      const btnNext = document.getElementById('game-next') as HTMLButtonElement

      const pokemons: GamePokemon[] = JSON.parse(game.dataset.pokemons ?? '[]')
      let current: GamePokemon | undefined

      const showRandomPokemon = () => {
        current = pickOther(pokemons, current)

        delete game.dataset.revealed
        cry.onended = null
        speechSynthesis.cancel()

        image.src = current.image
        image.alt = 'Pokémon misterioso'
        name.textContent = current.name
        cry.src = current.cry
      }

      const reveal = () => {
        if (!current) return

        const { name: pokemonName, spokenName } = current

        game.dataset.revealed = ''
        image.alt = `Imagen de ${pokemonName}`
        cry.onended = () => speak(`¡Es ${spokenName}!`)
        playSound(cry)
      }

      btnReveal.addEventListener('click', reveal)
      btnNext.addEventListener('click', showRandomPokemon)
      showRandomPokemon()
    }

    document.addEventListener('astro:page-load', handleGame)
  </script>
</MainLayout>
