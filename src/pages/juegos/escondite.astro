---
import { Icon } from 'astro-icon/components'
import AlbumPrize from '@components/games/AlbumPrize.astro'
import GameHeader from '@components/games/GameHeader.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getGamePokemons } from 'services/game-pokemons'

const PAGE_TITLE = 'Escondite en la cueva'

const pokemons = await getGamePokemons()
---

<MainLayout title={PAGE_TITLE}>
  <GameHeader title={PAGE_TITLE} />

  {/* ¿Dónde está…? a oscuras (scripts/find-game). data-state: asking
      (preguntando) o found (encontrado). La casilla buena lleva data-target y
      la que se toca sin serlo, data-wrong mientras niega. Si lo encuentra a
      la primera, va al álbum (AlbumPrize) */}
  <div
    id='find'
    class='group relative grid gap-6 max-w-sm mx-auto'
    data-state='asking'
    data-pokemons={JSON.stringify(pokemons)}
  >
    {/* La cueva: a oscuras salvo la luz de la linterna, que sigue al dedo
        (scripts/flashlight). Al encontrarlo se enciende la luz y se ven todos.
        Solo hay transición al encenderse: al pasar al siguiente se apaga de
        golpe, para que no se vea dónde están los nuevos */}
    <div
      class='flashlight grid grid-cols-3 gap-3 p-3 rounded-3xl bg-radial from-stone-500 to-stone-800 group-data-[state=found]:after:opacity-0 group-data-[state=found]:after:transition-opacity group-data-[state=found]:after:duration-700'
    >
      {
        Array.from({ length: 9 }, () => (
          <button
            data-option
            class='grid place-items-center aspect-square transition-[opacity,scale] active:scale-95 motion-safe:data-wrong:animate-pokemon-no group-data-[state=found]:not-data-target:opacity-30 motion-safe:group-data-[state=found]:data-target:animate-battle-cheer'
          >
            <img
              alt=''
              class='aspect-square w-full'
            />
          </button>
        ))
      }
    </div>

    <div class='grid grid-cols-2 gap-4'>
      <button
        id='find-ask'
        aria-label='Repetir la pregunta'
        class='btn-big bg-sky-600 hover:bg-sky-700'
      >
        <Icon
          name='voice'
          size={40}
        />
      </button>
      <button
        id='find-next'
        aria-label='Otro'
        class='btn-big bg-orange-700 hover:bg-orange-800'
      >
        <Icon
          name='arrow-right'
          size={40}
        />
      </button>
    </div>

    <AlbumPrize />
  </div>
  <audio
    id='find-cry'
    preload='auto'
  ></audio>

  <script>
    import 'scripts/find-game'
    import 'scripts/flashlight'
  </script>
</MainLayout>
