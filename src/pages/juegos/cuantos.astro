---
import { Icon } from 'astro-icon/components'
import AlbumPrize from '@components/games/AlbumPrize.astro'
import GameHeader from '@components/games/GameHeader.astro'
import MainLayout from '@layouts/MainLayout.astro'
import { getGamePokemons } from 'services/game-pokemons'

const PAGE_TITLE = '¿Cuántos hay?'

const pokemons = await getGamePokemons()

// Hasta 20: un sitio para cada uno, en 5 columnas. En las sumas, un grupo en
// las 2 de la izquierda y otro en las 2 de la derecha (hasta 8 + 8), y en la
// del medio, el «+»
const PLACES = 20
---

<MainLayout title={PAGE_TITLE}>
  <GameHeader title={PAGE_TITLE} />

  {/* data-state: asking (preguntando) o found (acertado). data-mode: count
      (contar) o sum (sumar dos grupos, una de cada 3 rondas). Los sitios que
      no tienen Pokémon llevan data-empty y los ya contados, data-counted; la
      respuesta buena lleva data-right y la que se toca sin serlo, data-wrong
      mientras niega. Si acierta a la primera, el Pokémon (o los dos) va al
      álbum (AlbumPrize) */}
  <div
    id='count'
    class='group relative grid gap-6 max-w-sm mx-auto'
    data-state='asking'
    data-mode='count'
    data-pokemons={JSON.stringify(pokemons)}
  >
    {/* La suma en cifras (3 + 2), solo en las de sumar. Guarda su alto
        también al contar: si no, los botones de abajo cambiarían de sitio de
        una ronda a otra */}
    <p
      id='count-sum'
      class='min-h-10 text-center text-4xl font-black'
    >
    </p>

    {/* El prado. Los sitios vacíos guardan su hueco (invisible): el prado
        mide siempre lo mismo. Al sumar, el «+» en la columna del medio, que
        queda vacía */}
    <div class='relative grid grid-cols-5 gap-2 p-3 rounded-2xl bg-linear-to-b from-lime-200 to-lime-400'>
      <span
        aria-hidden='true'
        class='pointer-events-none absolute inset-0 hidden place-items-center text-6xl font-black text-lime-800 group-data-[mode=sum]:grid'
      >
        +
      </span>
      {
        Array.from({ length: PLACES }, () => (
          <button
            data-cell
            class='relative aspect-square transition-transform active:scale-95 data-empty:invisible motion-safe:group-data-[state=found]:animate-battle-cheer'
          >
            <img
              alt=''
              class='aspect-square w-full'
            />
            {/* El número que le ha tocado al contarlo */}
            <span
              data-number
              class='absolute -top-1 -right-1 hidden size-6 place-items-center rounded-full bg-orange-600 text-sm font-black text-white in-data-counted:grid'
            ></span>
          </button>
        ))
      }
    </div>

    {/* Las respuestas, en cifra (Ibai lee los números) y de menor a mayor */}
    <div class='grid grid-cols-3 gap-4'>
      {
        [0, 1, 2].map(() => (
          <button
            data-answer
            class='btn-big bg-indigo-600 text-4xl font-black transition-[opacity,scale] motion-safe:data-wrong:animate-pokemon-no group-data-[state=found]:data-right:bg-green-600 group-data-[state=found]:not-data-right:opacity-30'
          ></button>
        ))
      }
    </div>

    <div class='grid grid-cols-2 gap-4'>
      <button
        id='count-ask'
        aria-label='Repetir la pregunta'
        class='btn-big bg-sky-600 hover:bg-sky-700'
      >
        <Icon
          name='voice'
          size={40}
        />
      </button>
      <button
        id='count-next'
        aria-label='Otro'
        class='btn-big bg-orange-700 hover:bg-orange-800'
      >
        <Icon
          name='arrow-right'
          size={40}
        />
      </button>
    </div>

    <AlbumPrize />
  </div>
  <audio
    id='count-cry'
    preload='auto'
  ></audio>

  <script>
    import type { GamePokemon } from 'interfaces/game-pokemon'
    import { clearAlbumReward, rewardAlbum } from 'scripts/album'
    import { animationsEnd } from 'scripts/animations'
    import { createDeck, drawDistinct, pickSome } from 'scripts/random'
    import { canSpeak, playSound, speak } from 'scripts/sounds'

    type State = 'asking' | 'found'
    type Mode = 'count' | 'sum'
    // Unos cuantos del mismo Pokémon. Al contar hay un grupo; al sumar, dos
    type Group = { pokemon: GamePokemon; size: number }

    // Las respuestas que no son están cerca de la buena, a 3 como mucho: para
    // acertar hay que contar
    const NEAR = 3
    // Una de cada 3 rondas es una suma
    const SUM_EVERY = 3
    // El prado tiene 5 columnas (grid-cols-5)
    const COLUMNS = 5

    // «Hay un Pikachu», y no «uno»
    const sayNumber = (n: number) => (n === 1 ? 'un' : String(n))

    const handleCount = () => {
      const count = document.getElementById('count') as HTMLDivElement

      if (!count) return

      const cells = [...count.querySelectorAll<HTMLButtonElement>('[data-cell]')]
      const answers = [...count.querySelectorAll<HTMLButtonElement>('[data-answer]')]
      const sum = document.getElementById('count-sum') as HTMLParagraphElement
      const cry = document.getElementById('count-cry') as HTMLAudioElement
      const btnAsk = document.getElementById('count-ask') as HTMLButtonElement
      const btnNext = document.getElementById('count-next') as HTMLButtonElement
      const prize = count.querySelector('[data-album-prize]') as HTMLElement

      // Al sumar, un grupo en las 2 columnas de la izquierda y otro en las 2
      // de la derecha; la del medio, vacía, es la del «+»
      const column = (cell: HTMLButtonElement) => cells.indexOf(cell) % COLUMNS
      const left = cells.filter((cell) => column(cell) < 2)
      const right = cells.filter((cell) => column(cell) > 2)

      const pokemons: GamePokemon[] = JSON.parse(count.dataset.pokemons ?? '[]')
      // Ni el Pokémon, ni cuántos hay (de 1 a uno por sitio), ni la suma (de
      // 1 + 1 a 8 + 8) se repiten hasta que han salido todos
      const drawPokemon = createDeck(pokemons)
      const drawTotal = createDeck(cells.map((_, index) => index + 1))
      const drawSum = createDeck(
        left.flatMap((_, a) => right.map((_, b): [number, number] => [a + 1, b + 1]))
      )
      let groups: Group[] = []
      let total = 0
      let counted = 0
      let choices: number[] = []
      // Si ya ha tocado una respuesta que no era: entonces no va al álbum
      let missed = false
      // Cada pregunta es otra ronda: lo que quedara de la anterior se descarta
      let round = 0

      const getState = () => count.dataset.state as State
      const setState = (state: State) => {
        count.dataset.state = state
      }

      const ask = () => {
        const [first, second] = groups

        if (!first) return

        speak(
          second
            ? `¿Cuántos son ${sayNumber(first.size)} ${first.pokemon.spokenName} y ${sayNumber(second.size)} ${second.pokemon.spokenName}?`
            : `¿Cuántos ${first.pokemon.spokenName} hay?`
        )
      }

      // reward: lo que añade el álbum, si es nuevo o trae medalla
      const sayFound = (reward = '') => {
        const [first, second] = groups

        if (!first) return

        const phrase = second
          ? `¡Muy bien! ¡${first.size} y ${second.size} son ${total}!${reward}`
          : `¡Muy bien! ¡Hay ${sayNumber(total)} ${first.pokemon.spokenName}!${reward}`
        speechSynthesis.cancel()
        cry.onended = () => speak(phrase)
        playSound(cry)
      }

      // Cada grupo, en sitios al azar de su zona (al contar, todo el prado), y
      // las respuestas: la buena y otras dos cerca, de menor a mayor
      const showRound = () => {
        round++
        missed = false
        clearAlbumReward(prize)
        cry.onended = null
        speechSynthesis.cancel()

        const mode: Mode = round % SUM_EVERY === 0 ? 'sum' : 'count'
        let areas: HTMLButtonElement[][]

        if (mode === 'sum') {
          const [a, b] = drawDistinct(drawPokemon, 2)
          const [sizeA, sizeB] = drawSum()
          groups = [
            { pokemon: a, size: sizeA },
            { pokemon: b, size: sizeB }
          ]
          areas = [left, right]
        } else {
          groups = [{ pokemon: drawPokemon(), size: drawTotal() }]
          areas = [cells]
        }
        total = groups.reduce((sum, { size }) => sum + size, 0)
        counted = 0

        cells.forEach((cell) => {
          cell.dataset.empty = ''
          delete cell.dataset.counted
        })
        groups.forEach(({ pokemon, size }, index) =>
          pickSome(areas[index], size).forEach((cell) => {
            const img = cell.querySelector('img') as HTMLImageElement
            img.src = pokemon.image
            cell.setAttribute('aria-label', pokemon.name)
            delete cell.dataset.empty
          })
        )
        count.dataset.mode = mode
        sum.textContent = mode === 'sum' ? `${groups[0].size} + ${groups[1].size}` : ''

        const near = cells
          .map((_, index) => index + 1)
          .filter((n) => n !== total && Math.abs(n - total) <= NEAR)
        choices = [total, ...pickSome(near, answers.length - 1)].sort((a, b) => a - b)
        answers.forEach((answer, index) => {
          answer.textContent = String(choices[index])
          answer.toggleAttribute('data-right', choices[index] === total)
          delete answer.dataset.wrong
        })
        cry.src = groups[0].pokemon.cry
        setState('asking')
      }

      // Contar con el dedo: cada uno que se toca se queda con su número y la
      // voz lo dice. Uno ya contado vuelve a decir el suyo. Como no se repiten,
      // el último número es cuántos ha contado (al sumar, los de los dos lados)
      const countCell = (cell: HTMLButtonElement) => {
        if (getState() !== 'asking') return

        const number = cell.querySelector('[data-number]') as HTMLSpanElement

        if (!('counted' in cell.dataset)) {
          counted++
          number.textContent = String(counted)
          cell.dataset.counted = ''
        }
        speak(number.textContent ?? '')
      }

      const choose = async (answer: HTMLButtonElement, n: number) => {
        // Ya acertado: tocar la buena lo vuelve a decir
        if (getState() === 'found') {
          if (n === total) sayFound()
          return
        }

        // A la primera, van al álbum (al sumar, los dos)
        if (n === total) {
          setState('found')
          sayFound(missed ? '' : rewardAlbum(prize, groups.map(({ pokemon }) => pokemon.id)))
          return
        }

        // Esa no es: niega y le dice cómo saberlo. No se pierde, pero ya no
        // va al álbum
        if ('wrong' in answer.dataset) return

        const thisRound = round
        missed = true
        answer.dataset.wrong = ''
        speak(`¡${n} no! ¡Cuéntalos con el dedo!`)
        await animationsEnd(answer)
        if (thisRound !== round) return

        delete answer.dataset.wrong
      }

      cells.forEach((cell) => cell.addEventListener('click', () => countCell(cell)))
      answers.forEach((answer, index) =>
        answer.addEventListener('click', () => choose(answer, choices[index]))
      )
      btnAsk.addEventListener('click', ask)
      btnNext.addEventListener('click', () => {
        showRound()
        ask()
      })
      showRound()
      if (canSpeak()) ask()
    }

    document.addEventListener('astro:page-load', handleCount)
  </script>
</MainLayout>
