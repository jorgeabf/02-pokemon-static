---
import { Image } from 'astro:assets'
import { getSpanishNames } from 'services/pokemon-species'

interface Props {
  url: string
  name: string
}

const { url, name } = Astro.props
const id = url.split('/').at(-2)
const spanishName = (await getSpanishNames())[name] ?? name

const image = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`
---

<a href={`/pokemons/${name}`}>
  <article class='bg-slate-900 border border-slate-600 p-4 rounded-2xl relative'>
    <slot />

    <Image
      transition:name={`${name}-image`}
      src={image}
      alt={`Imagen de ${spanishName}`}
      class='mx-auto'
      width={180}
      height={180}
      format='avif'
      loading='eager'
    />

    <h3 class='text-center capitalize'>
      #{id} {spanishName}
    </h3>
  </article>
</a>
