---
import PageHeader from '@components/shared/PageHeader.astro'
import SpokenTitle from '@components/shared/SpokenTitle.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

{/* La de todos los juegos: el título, que se dice al tocarlo. Para volver a
    la lista de juegos está el mando del menú */}
<PageHeader>
  <SpokenTitle speech={title}>{title}</SpokenTitle>
</PageHeader>
