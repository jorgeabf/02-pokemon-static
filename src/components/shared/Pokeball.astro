---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'svg'> {
  topClass?: string
  bottomClass?: string
}

const { class: className, topClass, bottomClass, ...attrs } = Astro.props
---

{/* La Pokéball de favicon.svg, con las mitades por separado para poder abrirla.
    La de arriba gira sobre su esquina izquierda, como una tapa con bisagra */}
<svg
  viewBox='0 0 100 100'
  aria-hidden='true'
  class:list={['overflow-visible', className]}
  {...attrs}
>
  <g class:list={['transform-fill origin-bottom-left', topClass]}>
    <path
      d='M5 50a45 45 0 0 1 90 0Z'
      fill='#ef4444'
      stroke='#0f172a'
      stroke-width='6'
    />
  </g>
  <g class:list={['transform-fill', bottomClass]}>
    <path
      d='M5 50a45 45 0 0 0 90 0Z'
      fill='#ffffff'
      stroke='#0f172a'
      stroke-width='6'
    />
    <circle
      cx='50'
      cy='50'
      r='13'
      fill='#ffffff'
      stroke='#0f172a'
      stroke-width='6'
    />
    <circle
      cx='50'
      cy='50'
      r='5'
      fill='#ffffff'
      stroke='#0f172a'
      stroke-width='2'
    />
  </g>
</svg>
