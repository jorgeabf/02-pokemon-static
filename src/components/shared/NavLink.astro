---
interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props

// La sección es el primer tramo de la ruta: /pokemons/2/ y /pokemons/pikachu
// son de «Pokémons», /donde-viven/bosque/ es de «Dónde viven»
const getSection = (path: string) => path.split('/')[1]

const currentPath = Astro.url.pathname
const isCurrentSection = getSection(href) === getSection(currentPath)
---

{/* La sección actual lleva un fondo detrás del dibujo, para que Ibai vea dónde está */}
<li>
  <a
    href={href}
    aria-label={label}
    aria-current={
      currentPath === href ? 'page' : isCurrentSection ? 'true' : undefined
    }
    data-speak={label}
    class:list={[
      'block p-1 rounded-2xl transition-transform active:scale-95',
      { 'bg-slate-700': isCurrentSection }
    ]}
  >
    <slot />
  </a>
</li>
