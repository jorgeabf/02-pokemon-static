---
interface Props {
  // El ancho; lo demás (la cinta, el borde, el número) va en proporción
  class: string
}

const { class: className } = Astro.props
---

{/* Una medalla: la cinta y, colgando, el disco dorado con el número del slot.
    Es su propio contenedor: el borde y el número se miden en cqi, así que se
    ve igual de pequeña en el álbum que de grande en ¡Atrápalo! */}
<span class:list={['@container grid justify-items-center', className]}>
  <span
    class='w-1/2 aspect-4/3 bg-red-600 [clip-path:polygon(0_0,100%_0,100%_100%,50%_75%,0_100%)]'
  ></span>
  <span
    class='-mt-[10cqi] grid place-items-center aspect-square w-full rounded-full border-[6cqi] border-amber-500 bg-radial from-yellow-100 to-yellow-400 text-[36cqi] leading-none font-black text-amber-800'
  >
    <slot />
  </span>
</span>
