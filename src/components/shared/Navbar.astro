---
const navItems = [
  { href: '/pokemons/1/', text: 'Pokemons' },
  { href: '/favoritos/', text: 'Favoritos' }
]

const currentPath = Astro.url.pathname
---

<nav class='bg-white shadow-sm dark:bg-slate-800'>
  <ul
    class='container flex justify-center gap-8 sm:gap-12 p-4 mx-auto text-gray-800 capitalize dark:text-gray-200'
  >
    {
      navItems.map(({ href, text }) => (
        <li>
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
          >
            {text}
          </a>
          {currentPath === href ? (
            <div
              transition:name='nav-line'
              class='mt-1 border-b-2 border-indigo-500'
            />
          ) : (
            <div class='mt-1 border-b-2 border-transparent' />
          )}
        </li>
      ))
    }
  </ul>
</nav>
