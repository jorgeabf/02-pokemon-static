---
import { Icon } from 'astro-icon/components'
import NavLink from '@components/shared/NavLink.astro'
import Pokeball from '@components/shared/Pokeball.astro'
import { POKEMON_HABITATS } from 'consts/pokemon-habitats'
import { getPokemonDrawings } from 'services/pokemon-images'

// Cada enlace es un dibujo de su página, para que Ibai lo reconozca sin leer
const habitatTiles = POKEMON_HABITATS.filter(({ key }) =>
  ['forest', 'sea', 'mountain', 'urban'].includes(key)
)
// Pikachu, Bulbasaur, Charmander y Squirtle
const albumSample = [
  { id: 25, captured: true },
  { id: 1, captured: false },
  { id: 4, captured: false },
  { id: 7, captured: true }
]
const drawings = await getPokemonDrawings(albumSample.map(({ id }) => id))
---

{/* Fijo arriba para cambiar de sección sin subir; z-10 lo deja encima de lo
    que se apila en las páginas (tarjetas, la oscuridad de la cueva…). Su
    alto es el token --spacing-nav (global.css), que usan las anclas */}
<nav class='sticky top-0 z-10 h-nav bg-slate-900 border-b border-slate-600'>
  {/* Columnas iguales: a 320 px cada una mide 57,6 y cabe el fondo de 56 de
      la sección actual */}
  <ul class='grid grid-cols-5 justify-items-center max-w-lg px-4 py-1 mx-auto'>
    {/* Mantenerla pulsada abre la «hora de descansar» para el adulto */}
    <NavLink
      href='/pokemons/'
      label='Pokémons'
      data-parent-hold='panel'
    >
      {/* La misma Pokéball que el icono de la app */}
      <Pokeball class='size-12' />
    </NavLink>
    <NavLink
      href='/favoritos/'
      label='Favoritos'
    >
      <Icon
        name='heart-full'
        class='size-12 text-red-600'
      />
    </NavLink>
    <NavLink
      href='/juegos/'
      label='Juegos'
    >
      <Icon
        name='game-controller'
        class='size-12 text-violet-500'
      />
    </NavLink>
    <NavLink
      href='/donde-viven/'
      label='Dónde viven'
    >
      {/* Como las casillas de la página de los sitios */}
      <span class='grid grid-cols-2 gap-1 size-12'>
        {
          habitatTiles.map(({ icon, tile }) => (
            <span
              class:list={[
                'grid place-items-center rounded-md bg-linear-to-b text-white',
                tile
              ]}
            >
              <Icon
                name={icon}
                class='size-4'
              />
            </span>
          ))
        }
      </span>
    </NavLink>
    <NavLink
      href='/album/'
      label='Mi álbum'
    >
      {/* Como el álbum: unos atrapados en color y otros aún en sombra */}
      <span class='grid grid-cols-2 grid-rows-2 gap-1 size-12'>
        {
          albumSample.map(({ id, captured }) => (
            <img
              src={drawings[id]}
              alt=''
              width='22'
              height='22'
              class:list={[
                'size-full object-contain',
                { 'brightness-0 invert opacity-30': !captured }
              ]}
            />
          ))
        }
      </span>
    </NavLink>
  </ul>
  {/* Lo que lleva guardado para jugar sin conexión, sobre el borde de abajo:
      solo mientras guarda (lo rellena scripts/service-worker.ts). Persiste al
      navegar, para no volver a empezar oculta en cada página */}
  <progress
    id='offline-progress'
    transition:persist='offline-progress'
    hidden
    aria-label='Guardando para jugar sin conexión'
    class='absolute inset-x-0 -bottom-px w-full h-1 appearance-none bg-transparent [&::-webkit-progress-bar]:bg-transparent [&::-webkit-progress-value]:bg-sky-400 [&::-moz-progress-bar]:bg-sky-400 data-done:[&::-webkit-progress-value]:bg-green-500 data-done:[&::-moz-progress-bar]:bg-green-500 data-done:animate-offline-ready'
  ></progress>
</nav>
