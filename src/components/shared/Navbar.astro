---
import { Icon } from 'astro-icon/components'
import NavLink from '@components/shared/NavLink.astro'
import Pokeball from '@components/shared/Pokeball.astro'
import { POKEMON_HABITATS } from 'consts/pokemon-habitats'

// Cada enlace es un dibujo de su página, para que Ibai lo reconozca sin leer
const habitatTiles = POKEMON_HABITATS.filter(({ key }) =>
  ['forest', 'sea', 'mountain', 'urban'].includes(key)
)
---

<nav class='bg-white shadow-sm dark:bg-slate-800'>
  <ul
    class='container flex justify-between gap-3 sm:justify-center sm:gap-12 px-4 py-1 mx-auto'
  >
    <NavLink
      href='/pokemons/1/'
      label='Pokémons'
    >
      {/* La misma Pokéball que el icono de la app */}
      <Pokeball class='size-12' />
    </NavLink>
    <NavLink
      href='/favoritos/'
      label='Favoritos'
    >
      <Icon
        name='heart-full'
        class='size-12 text-red-600'
      />
    </NavLink>
    <NavLink
      href='/adivina/'
      label='Adivina'
    >
      {/* Mini pantalla del juego: silueta sobre su mismo fondo */}
      <span
        class='grid place-items-center size-12 rounded-lg bg-radial from-yellow-200 to-sky-500'
      >
        <img
          src='https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/dream-world/25.svg'
          alt=''
          width='40'
          height='40'
          class='size-10 brightness-0'
        />
      </span>
    </NavLink>
    <NavLink
      href='/donde-viven/'
      label='Dónde viven'
    >
      {/* Como las casillas de la página de los sitios */}
      <span class='grid grid-cols-2 gap-1 size-12'>
        {
          habitatTiles.map(({ icon, tile }) => (
            <span
              class:list={[
                'grid place-items-center rounded-md bg-linear-to-b text-white',
                tile
              ]}
            >
              <Icon
                name={icon}
                class='size-4'
              />
            </span>
          ))
        }
      </span>
    </NavLink>
    <NavLink
      href='/sorpresa/'
      label='Sorpresa'
    >
      {/* La Pokéball de inicio, pero abriéndose y con un destello */}
      <span class='relative block size-12'>
        <Pokeball
          class='absolute bottom-0 left-0 size-10'
          topClass='-rotate-30'
        />
        <Icon
          name='sparkle'
          class='absolute top-0 right-0 size-6 text-yellow-400'
        />
      </span>
    </NavLink>
  </ul>
</nav>
