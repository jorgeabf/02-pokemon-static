{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "interfaces/*": ["./src/interfaces/*"],
      "consts/*": ["./src/consts/*"],
      "services/*": ["./src/services/*"],
      "scripts/*": ["./src/scripts/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
